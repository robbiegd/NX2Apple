From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Robert Johnson <robbiegd117@gmail.com>
Date: Fri, 6 Nov 2026 17:05:30 -0700
Subject: [PATCH] ios: build the shell for visionOS

Add a standard windowed visionOS shell build alongside iOS. Keep iOS-only folder picking and orientation policies gated, and cover the new platform with an unsigned synthetic shell build test.

Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>

Upstream-Status: pending
Reason: Add standard windowed visionOS support to the generated iOS shell app and its build/test path.
Issue: seedds/nxnative#1601

---
 dm/ios/Shell/ShellApp.swift      |  9 ++++++++-
 dm/ios/Shell/ShellMain.m         |  6 ++++++
 dm/ios/project-shell.yml         |  3 ++-
 dm/ios/tests/test_shell_build.py | 24 ++++++++++++++++++++----
 dm/ios/tools/build_shell.sh      | 16 +++++++++++-----
 5 files changed, 47 insertions(+), 11 deletions(-)

diff --git a/dm/ios/Shell/ShellApp.swift b/dm/ios/Shell/ShellApp.swift
index 8dbe45f..80fbc34 100644
--- a/dm/ios/Shell/ShellApp.swift
+++ b/dm/ios/Shell/ShellApp.swift
@@ -54,7 +54,12 @@ private func withCStrings<R>(_ strings: [String], _ body: (UnsafePointer<UnsafeP
         let config = ShellHostConfig(gamesRoot: frameworks, appDataRoot: ShellHostConfig.defaultAppDataRoot(),
                                      environment: HostEnvironment(chain: chain),
                                      updateURL: URL(string: "https://github.com/LNPANDY/NX2Apple/releases"))
-        let model = ShellHostModel(config: config, launcher: EngineGameLauncher(), picker: DocumentFolderPicker())
+        #if os(iOS)
+        let picker: any FolderPicker = DocumentFolderPicker()
+        #else
+        let picker: any FolderPicker = NoFolderPicker()
+        #endif
+        let model = ShellHostModel(config: config, launcher: EngineGameLauncher(), picker: picker)
         model.startControllers()
         for entry in model.entries {
             fputs("shell: game \(entry.id) \(entry.title) at \(entry.frameworkURL?.lastPathComponent ?? "-")\(entry.problem.map { ", broken: \($0.reason), \($0.detail)" } ?? "")\n", stderr)
@@ -67,7 +72,9 @@ private func withCStrings<R>(_ strings: [String], _ body: (UnsafePointer<UnsafeP
             DispatchQueue.main.async { model.play(id) }
         }
         let host = UIHostingController(rootView: ShellHostView(model: model))
+        #if os(iOS)
         host.view.backgroundColor = .black
+        #endif
         return host
     }
 }
diff --git a/dm/ios/Shell/ShellMain.m b/dm/ios/Shell/ShellMain.m
index 7fb0bfc..992308c 100644
--- a/dm/ios/Shell/ShellMain.m
+++ b/dm/ios/Shell/ShellMain.m
@@ -95,14 +95,18 @@ void dm_shell_present_game(void) {
 @interface App : UIResponder <UIApplicationDelegate>
 @end
 // Browsing may be portrait; phone gameplay stays landscape. UIKit manages unrestricted rotation on the Duo inner display.
+#if !TARGET_OS_VISION
 static UIInterfaceOrientationMask shell_orientations(UITraitCollection *traits) {
     if (traits.userInterfaceIdiom != UIUserInterfaceIdiomPhone) return UIInterfaceOrientationMaskAll;
     return g_boot_ok ? UIInterfaceOrientationMaskLandscape : UIInterfaceOrientationMaskAllButUpsideDown;
 }
+#endif
 @implementation App
+#if !TARGET_OS_VISION
 - (UIInterfaceOrientationMask)application:(UIApplication *)application supportedInterfaceOrientationsForWindow:(UIWindow *)window {
     return shell_orientations(window.traitCollection);   // iOS 26
 }
+#endif
 - (UISceneConfiguration *)application:(UIApplication *)a configurationForConnectingSceneSession:(UISceneSession *)s options:(UISceneConnectionOptions *)o {
     return [[UISceneConfiguration alloc] initWithName:@"Default" sessionRole:s.role];
 }
@@ -112,9 +116,11 @@ static UIInterfaceOrientationMask shell_orientations(UITraitCollection *traits)
 @property (strong, nonatomic) UIWindow *window;
 @end
 @implementation SceneDelegate
+#if !TARGET_OS_VISION
 - (UIInterfaceOrientationMask)supportedInterfaceOrientationsForWindowScene:(UIWindowScene *)windowScene {
     return shell_orientations(windowScene.traitCollection);   // iOS 27 and later
 }
+#endif
 - (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)o {
     self.window = [[UIWindow alloc] initWithWindowScene:(UIWindowScene *)scene];
     self.window.rootViewController = [ShellLibrary makeController];
diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index 60fda10..f71b26b 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -11,6 +11,7 @@ options:
   bundleIdPrefix: ${DM_BUNDLE_ID}
   deploymentTarget:
     iOS: "26.0"
+    visionOS: "26.0"
 configFiles:     # build_shell.sh: the host's header paths, defines and frameworks from dm/host/Makefile (gen_build.py)
   Release: Gen/dm.xcconfig
   Debug: Gen/dm.xcconfig
@@ -20,7 +21,7 @@ packages:
 targets:
   DmShell:
     type: application
-    platform: iOS
+    platform: ${DM_SHELL_PLATFORM}
     sources:
       - path: Shell           # the shell's main, its scene, the library and the real GameLauncher (dm/ios/Shell)
       - path: Gen/dm          # the host's shared files (dm/font for DM_FONT_DIR); every game's host and tables live in its framework
diff --git a/dm/ios/tests/test_shell_build.py b/dm/ios/tests/test_shell_build.py
index 2f5b1ad..c6a1363 100644
--- a/dm/ios/tests/test_shell_build.py
+++ b/dm/ios/tests/test_shell_build.py
@@ -2,7 +2,7 @@
 
 The checks of the frameworks it is given run anywhere: a manifest of another shader chain, two frameworks of one title, a folder
 whose name the manifest does not give and a missing executable are refused before anything is generated, and two games go into one
-shell (the host reads each game's runtime profile). With XcodeGen and an iPhoneOS SDK the shell is also generated and built, unsigned, around a synthetic
+shell (the host reads each game's runtime profile). With XcodeGen and an Apple SDK the shell is also generated and built, unsigned, around a synthetic
 framework (a one-symbol dylib, no game code): the app embeds the framework without linking it (the shell dlopens it), carries
 LC_RPATH @executable_path/Frameworks, the frontend-ios package's resource bundles, its name and the chain in Info.plist, and a prepared
 project asks for the Increased Memory Limit (DM_ENTITLEMENTS= leaves it out). No game files, shaders or signing are involved.
@@ -35,7 +35,7 @@ def font_python():
     return None
 
 
-def framework(root, title=GAME, chain=CHAIN, loader='FH', name=None, executable=True, compile_it=False):
+def framework(root, title=GAME, chain=CHAIN, loader='FH', name=None, executable=True, compile_it=False, platform='iphoneos'):
     """A framework folder as build_ipa.sh DM_FRAMEWORK_ONLY writes it, with a manifest and, optionally, a real arm64 dylib."""
     name = name or f'DmGame{title}'
     fw = Path(root) / f'{name}.framework'
@@ -51,12 +51,13 @@ def framework(root, title=GAME, chain=CHAIN, loader='FH', name=None, executable=
     (fw / 'profile.tsv').write_text(f'id\t{title}\n')
     plist = {'CFBundleExecutable': exe, 'CFBundleIdentifier': f'org.nxnative.ci.{title.lower()}', 'CFBundleName': exe,
              'CFBundlePackageType': 'FMWK', 'CFBundleShortVersionString': '1.0', 'CFBundleVersion': '1.0',
-             'CFBundleSupportedPlatforms': ['iPhoneOS'], 'MinimumOSVersion': '26.0'}
+             'CFBundleSupportedPlatforms': ['XROS' if platform == 'xros' else 'iPhoneOS'], 'MinimumOSVersion': '26.0'}
     (fw / 'Info.plist').write_bytes(plistlib.dumps(plist))
     if compile_it:
         src = Path(root) / 'marker.c'
         src.write_text('__attribute__((used, visibility("default"))) const char dmgame_image_marker[] = "DmGame";\n')
-        r = subprocess.run(['xcrun', '-sdk', 'iphoneos', 'clang', '-arch', 'arm64', '-mios-version-min=26.0', '-dynamiclib',
+        flags = ['-target', 'arm64-apple-xros26.0'] if platform == 'xros' else ['-arch', 'arm64', '-mios-version-min=26.0']
+        r = subprocess.run(['xcrun', '-sdk', platform, 'clang', *flags, '-dynamiclib',
                             '-install_name', f'@rpath/{exe}.framework/{exe}', str(src), '-o', str(fw / exe)], capture_output=True, text=True, check=False)
         assert r.returncode == 0, r.stderr
     elif executable:
@@ -175,6 +176,21 @@ class ShellBuild(unittest.TestCase):
         self.assertNotIn(fw.stem, subprocess.run(['otool', '-L', str(app / 'DmShell')], capture_output=True, text=True, check=False).stdout,
                          'the shell dlopens the game framework, it must not link it')
 
+    def test_the_shell_builds_for_visionos(self):
+        root = Path(tempfile.mkdtemp()).resolve()
+        self.addCleanup(shutil.rmtree, root)
+        fw = framework(root / 'frameworks', compile_it=True, platform='xros')
+        shell = root / 'shell'
+        r = run_script('--build', [fw], shell, FONT_PY=font_python(), DM_SHELL_PLATFORM='visionOS',
+                       DM_SHELL_NAME='Vision Fixture', DM_BUNDLE_ID='org.nxnative.ci.vision')
+        log = (shell / 'build.log').read_text() if (shell / 'build.log').exists() else ''
+        self.assertEqual(r.returncode, 0, r.stdout[-3000:] + log[-4000:])
+        app = shell / 'dd/Build/Products/Release-xros/DmShell.app'
+        info = plistlib.loads((app / 'Info.plist').read_bytes())
+        self.assertEqual(info['CFBundleDisplayName'], 'Vision Fixture')
+        self.assertEqual(info['CFBundleIdentifier'], 'org.nxnative.ci.vision')
+        self.assertTrue((app / f'Frameworks/{fw.name}/{fw.stem}').is_file())
+
 
 if __name__ == '__main__':
     unittest.main()
diff --git a/dm/ios/tools/build_shell.sh b/dm/ios/tools/build_shell.sh
index 8c9c2df..7deecc6 100755
--- a/dm/ios/tools/build_shell.sh
+++ b/dm/ios/tools/build_shell.sh
@@ -5,7 +5,7 @@
 # Usage: dm/ios/tools/build_shell.sh --prepare-xcode | --build
 #   --prepare-xcode  generates the project in SHELL_DIR and stops: Xcode (or xcodebuild with a team and a device, as the Mac launcher
 #                    does) signs every framework and the app and installs it; nothing is signed or installed here
-#   --build          also builds it for iOS, unsigned (CODE_SIGNING_ALLOWED=NO), to check it compiles and links (CI, off a device)
+#   --build          also builds it for the selected platform, unsigned (CODE_SIGNING_ALLOWED=NO), to check it compiles and links (CI, off a device)
 # Environment:
 #   SHELL_DIR            the shell's project folder (required; outside dm/ios, on the drive with the games: Gen/, the project, derived data)
 #   DM_SHELL_FRAMEWORKS  the games' framework folders, one per line (required, at least one; <folder>/DmGame<title ID>.framework)
@@ -14,6 +14,7 @@
 #   DM_TEAM_ID           the signing team for the prepared project (default 0000000000, a placeholder)
 #   DM_SHELL_NAME        the name under the icon (default NX2Apple); DM_APP_VERSION the app version (default 1.0)
 #   DM_SHELL_PACKAGE     the frontend-ios Swift package (default: frontend-ios beside dm/ in this checkout)
+#   DM_SHELL_PLATFORM    XcodeGen platform name: iOS (default) or visionOS
 #   DM_XCODE_DERIVED_DATA  derived data (default SHELL_DIR/dd); FONT_PY / STD_FONT as for build_ipa.sh
 #   DM_GAMES_DIR         passed through, for a provisional game profile
 #   DM_ENTITLEMENTS      empty: no Increased Memory Limit request in the prepared project (default: requested, as build_ipa.sh does)
@@ -32,7 +33,12 @@ mkdir -p "$SHELL_DIR" || die "mkdir $SHELL_DIR"; S=$(cd "$SHELL_DIR" && pwd)
 [ -n "${DM_SHELL_PACKAGE:-}" ] || { [ -f "$REPO/frontend-ios/Package.swift" ] && DM_SHELL_PACKAGE=$REPO/frontend-ios || DM_SHELL_PACKAGE=$(cd "$REPO/.." && pwd)/frontend-ios; }
 export DM_SHELL_PACKAGE
 [ -f "$DM_SHELL_PACKAGE/Package.swift" ] || die "no Swift package at $DM_SHELL_PACKAGE (DM_SHELL_PACKAGE)"
-export LC_ALL=C DM_BUNDLE_ID=${DM_BUNDLE_ID:-org.nxnative.shell} DM_TEAM_ID=${DM_TEAM_ID:-0000000000} DM_SHELL_NAME=${DM_SHELL_NAME:-NX2Apple} DM_APP_VERSION=${DM_APP_VERSION:-1.0}
+export LC_ALL=C DM_BUNDLE_ID=${DM_BUNDLE_ID:-org.nxnative.shell} DM_TEAM_ID=${DM_TEAM_ID:-0000000000} DM_SHELL_NAME=${DM_SHELL_NAME:-NX2Apple} DM_APP_VERSION=${DM_APP_VERSION:-1.0} DM_SHELL_PLATFORM=${DM_SHELL_PLATFORM:-iOS}
+case "$DM_SHELL_PLATFORM" in
+  iOS) XCODE_DESTINATION='generic/platform=iOS'; PRODUCT_DIR='Release-iphoneos' ;;
+  visionOS) XCODE_DESTINATION='generic/platform=visionOS'; PRODUCT_DIR='Release-xros' ;;
+  *) die "DM_SHELL_PLATFORM must be iOS or visionOS" ;;
+esac
 export DM_FORK_PATCHES=$(paste -sd, "$DM/fork_patches.txt" 2>/dev/null || true)
 DD=${DM_XCODE_DERIVED_DATA:-$S/dd}; mkdir -p "$DD" && DD=$(cd "$DD" && pwd)
 V=$(sed -n 's/^#define DMSH_CHAIN "\(.*\)"/\1/p' "$DM/gfx/nvn/dmsh_chain.h"); [ -n "$V" ] || die "no DMSH_CHAIN in dm/gfx/nvn/dmsh_chain.h"
@@ -105,11 +111,11 @@ if [ "$MODE" = --prepare-xcode ]; then
   exit 0
 fi
 
-t "xcodebuild (Release, unsigned, iPhone + iPad)"
-xcodebuild -project DmShell.xcodeproj -scheme DmShell -configuration Release -destination 'generic/platform=iOS' -derivedDataPath "$DD" \
+t "xcodebuild (Release, unsigned, $DM_SHELL_PLATFORM)"
+xcodebuild -project DmShell.xcodeproj -scheme DmShell -configuration Release -destination "$XCODE_DESTINATION" -derivedDataPath "$DD" \
   CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= build > "$S/build.log" 2>&1 \
   || { grep -E 'error:' "$S/build.log" | head -20; die "xcodebuild, log $S/build.log"; }
-APP=$DD/Build/Products/Release-iphoneos/DmShell.app
+APP=$DD/Build/Products/$PRODUCT_DIR/DmShell.app
 [ -x "$APP/DmShell" ] || die "no built app at $APP"
 while IFS=$'\t' read -r tid path name; do
   fw=$APP/Frameworks/$(basename "$path"); [ -d "$fw" ] || die "the app does not embed $(basename "$path")"
